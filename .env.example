# Copy to .env.local and fill in. .env.local is gitignored.

# ElevenLabs text-to-speech (optional; enables "Generate: ElevenLabs")
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# AI planner (optional). Without it the app falls back to the local `claude` CLI.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OmniVoice, local open-source TTS with native Indonesian (optional; enables "Generate: OmniVoice")
# Run `npm run setup:omnivoice` once, then `npm run omnivoice`. Weights are CC-BY-NC (non-commercial).
# OMNIVOICE_URL=http://127.0.0.1:17600
# Default voice id (GET /voices): wanita, pria, or one you added
# OMNIVOICE_VOICE=wanita
# Python for OmniVoice when it is not in tts/omnivoice/.venv. start:all reads it from here;
# npm run omnivoice only from the environment (OMNIVOICE_PYTHON=... npm run omnivoice).
# OMNIVOICE_PYTHON=/absolute/path/to/python

# Whisper caption timing (optional; run `npm run setup:whisper`)
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL=/absolute/path/to/ggml-large-v3-turbo-q5_0.bin

# Reel Studio server port (default 4310). Read from here or from the environment.
# PORT=4310
# Also answer this host name, for example through a Cloudflare Tunnel. Put a login (such as
# Cloudflare Access) in front of it: the app has no login of its own.
# PUBLIC_HOST=reel.example.com
# Cloudflare Tunnel that npm run start:all starts, using ~/.cloudflared/<TUNNEL_NAME>.yml
# TUNNEL_NAME=reel-studio
